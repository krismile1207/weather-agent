PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://weather:weather@localhost:5434/weather_agent
JWT_SECRET=请替换为至少32位的随机字符串
# Ollama 的 OpenAI 兼容接口；默认连接本机服务
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# 需提前在 Ollama 中下载，且应支持工具调用
OLLAMA_MODEL=qwen3.5:4b
# 可选：用 JSON 配置多个本地模型
# MODEL_CATALOG_JSON=[{"id":"ollama-qwen","label":"Qwen3.5 4B","model":"qwen3.5:4b","provider":"ollama"}]

